<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0-android;net8.0-ios;net8.0-windows10.0.19041.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>CareFlux.Maui</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationTitle>CareFlux</ApplicationTitle>
    <ApplicationId>com.careflux.platform</ApplicationId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../backend/CareFlux.Application/CareFlux.Application.csproj" />
    <ProjectReference Include="../../shared/CareFlux.Contracts/CareFlux.Contracts.csproj" />
  </ItemGroup>
</Project>
